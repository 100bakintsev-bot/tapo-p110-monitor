#!/bin/sh
set -eu
PROJECT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export TAPO_DATA_DIR="${TAPO_DATA_DIR:-$HOME/.local/share/tapo-p110-monitor}"
export TAPO_TIMEZONE="${TAPO_TIMEZONE:-Europe/Kyiv}"
if [ -n "${PREFIX:-}" ] && [ -x "$PREFIX/bin/proot-distro" ]; then
    exec "$PREFIX/bin/proot-distro" login debian -- env \
        TAPO_DATA_DIR="$TAPO_DATA_DIR" TAPO_TIMEZONE="$TAPO_TIMEZONE" \
        "$PROJECT/.venv/bin/python" -B "$PROJECT/read_tapo.py" "$@"
fi
exec "$PROJECT/.venv/bin/python" -B "$PROJECT/read_tapo.py" "$@"
